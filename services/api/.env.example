# Copy from repo root `.env.example` or set locally for @sokoos/api

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgresql://sokoos:sokoos@localhost:5432/sokoos?schema=public

# Optional: omit to run API without BullMQ workers (local demo still works)
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=600

# SaaS hostname model (SaaS-01)
SOKOOS_BASE_DOMAIN=sokoos.com
SOKOOS_PLATFORM_HOST=platform.sokoos.com
# Comma-separated extra public marketing hosts
SOKOOS_PUBLIC_HOSTS=
