{
  "name": "sokoos",
  "private": true,
  "version": "0.0.0",
  "description": "SokoOS — Africa's Offline-First Commerce Platform",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --concurrency=16",
    "dev": "turbo run dev --concurrency=16",
    "dev:api": "pnpm --filter @sokoos/api dev",
    "stack:api": "bash scripts/ensure-api.sh",
    "lint": "turbo run lint --concurrency=16",
    "test": "turbo run test --concurrency=16",
    "typecheck": "turbo run typecheck --concurrency=16",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
